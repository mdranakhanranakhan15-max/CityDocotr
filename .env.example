# OpenAI API Configuration (Optional - platform includes intelligent clinical rule engine fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ZEGOCLOUD Real-Time Video Call (ZegoUIKitPrebuilt)
# 1. Create a project at https://console.zegocloud.com -> get AppID (number) & Server Secret.
# 2. Note: token generation below happens on the client so both keys must be NEXT_PUBLIC_.
#    For production, prefer a server-side token server (generateKitTokenForProduction).
NEXT_PUBLIC_ZEGO_APP_ID=00
NEXT_PUBLIC_ZEGO_SERVER_SECRET=01

