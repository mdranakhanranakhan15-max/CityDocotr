datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  role      String   @default("SUPERADMIN")
  password  String? // Hashed login credential (bcrypt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  title           String?       @default("Consultant")
  designation     String        @default("Consultant")
  degrees         String        @default("MBBS, FCPS")
  specialty       String        @default("General Physician")
  specialties     String        @default("General Physician, Primary Care")
  workplace       String        @default("Dhaka Medical College Hospital")
  hospital        String        @default("Dhaka Medical College Hospital")
  education       String        @default("Dhaka Medical College")
  experienceYears Int           @default(5)
  rating          Float         @default(5.0)
  totalVisits     Int           @default(120)
  reviewsCount    Int           @default(120)
  fee             Int           @default(350)
  consultationFee Float         @default(350.0)
  email           String?       @unique // Login credential created by Admin
  phone           String? // Mobile number used as an alternate login identifier
  password        String? // Hashed login credential created by Admin (bcrypt)
  isOnline        Boolean       @default(true)
  status          String        @default("ACTIVE") // ACTIVE (approved/listed); ONLINE/OFFLINE = live presence
  image           String
  languages       String        @default("English, Bengali")
  bio             String        @default("Experienced physician dedicated to compassionate patient care and evidence-based clinical treatment.")
  badge           String?
  isVerified      Boolean       @default(true)

  // Lowercase department slug (e.g. "cardiology", "gynae-obs") so the
  // /department/[slug] pages can match doctors case-insensitively on MongoDB.
  departmentSlug  String?
  // Admin approval gate — every seeded / imported doctor is approved (true).
  isApproved      Boolean       @default(true)

  // --- Schedule & Slot Management ---
  availableDays       String  @default("Sat, Sun, Mon, Tue") // Comma-separated booking days (SQLite has no String[]/JSON)
  shiftStartTime      String  @default("10:00") // 24h format e.g. "14:00"
  shiftEndTime        String  @default("18:00") // 24h format e.g. "18:00"
  slotDuration        Int     @default(15) // Consultation minutes per patient (10/15/20/30)
  maxPatientsPerSlot  Int     @default(1) // Patients allowed per single time slot

  // --- Pricing & Tax Breakdown ---
  vatPercent              Float @default(5) // VAT % charged on top of the consultation fee
  platformFee             Float @default(29) // Fixed platform service charge in BDT
  doctorCommissionPercent Float @default(80) // % share of the consultation fee earned by the doctor

  // --- BMDC & Medical Compliance / Controls ---
  bmdcRegNum             String  @default("") // BMDC registration number (BD medical compliance)
  isInstantCallAvailable Boolean @default(true) // Enables "See Doctor Now" instant video call
  isOnVacation           Boolean @default(false) // Pauses new appointment bookings (doctor on leave)

  appointments    Appointment[]
  callEvents      CallEvent[]
  notifications   DoctorNotification[]
  prescriptions   Prescription[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Patient {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?       @unique
  phone        String?       @unique
  location     String?
  password     String?
  resetOtp     String? // Temporary 4-digit OTP for self-service password reset
  resetOtpExpiresAt DateTime? // When the temporary reset OTP stops being valid
  age          Int?
  gender       String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId        String   @db.ObjectId
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  patientId       String?  @db.ObjectId
  patient         Patient? @relation(fields: [patientId], references: [id])
  patientName     String
  patientEmail    String?
  patientPhone    String?
  patientLocation String?
  timeSlot        String?
  symptoms        String
  status          String   @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  paymentStatus   String   @default("UNPAID")    // UNPAID, PAID, REFUNDED
  paymentMethod   String?                        // BKASH, CARD
  transactionId   String?
  amountPaid      Float?
  scheduledAt     DateTime @default(now())
  meetingLink     String?
  notes           String?
  prescription    Prescription?
  callEvents      CallEvent[]
  notifications   DoctorNotification[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Real-time call notification events (patient waiting -> doctor accepts)
model CallEvent {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String      @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String      @db.ObjectId
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patientName   String
  type          String      @default("PATIENT_WAITING") // PATIENT_WAITING, CALL_ACCEPTED, CALL_ENDED
  payload       String? // Extra JSON data (e.g. timeSlot, phone)
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// Stored notification for the doctor (e.g. a call attempt while offline).
// Unlike CallEvent — which drives the real-time "Incoming Call" modal — these
// records are created when the patient calls but the doctor is NOT online, so
// the modal must not fire. The doctor can read them once back on the dashboard.
model DoctorNotification {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  doctorId      String       @db.ObjectId
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId String?  @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  type          String       @default("MISSED_CALL_OFFLINE") // MISSED_CALL_OFFLINE, PAYMENT_CONFIRMED, ...
  channel       String       @default("DB") // DB, SMS
  title         String
  message       String
  phone         String? // Doctor phone number the SMS alert was logged to
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

// Digital prescription saved by the doctor during the video consultation
model Prescription {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String      @unique @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String      @db.ObjectId
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patientId     String?
  doctorName    String
  patientName   String
  diagnosis     String
  medicines     String
  tests         String?
  advice        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model HeroBanner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  subtitle  String?
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= SITE STATS & METRICS CMS =================
// Homepage headline figures ("Patients Served", "BMDC Doctors", "Satisfaction %",
// "Doctors Online" badge) are managed live from Admin Panel -> Settings (Site Stats &
// Metrics) instead of being hardcoded. Stored as a flat key/value map — see
// app/api/settings/route.ts.
// The Admin Panel -> Reviews "Section Settings" card also lives here under the
// reviews.* keys (reviews.title / reviews.subtitle / reviews.countMode /
// reviews.customCount) — see app/api/reviews/settings/route.ts.
model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // e.g. "stats.patientsServed", "stats.bmdcDoctors"
  value     String // Display value e.g. "500K+", "2,500+", "98.4%"
  label     String? // Human-readable label shown in the Admin Settings CMS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= PATIENT REVIEWS / TESTIMONIALS CMS =================
// Patient testimonials shown on the public homepage. Managed live from the Admin
// Panel (app/admin/reviews). Rendered on the homepage with quote, name, the city
// location, a 1-5 rating and a service/department tag. The section header copy is
// configured via SiteSetting rows (see app/api/reviews/settings/route.ts).
model PatientReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // Patient name shown next to the avatar circle
  location  String // City / area, e.g. "Uttara, Dhaka"
  text      String // The review / testimonial quote
  rating    Int      @default(5) // Star rating 1-5
  service   String // Service / department tag, e.g. "Pediatrics Consultation"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= DEPARTMENTS & SYMPTOMS CMS =================
// The homepage "Consult by Medical Specialty" section is a dual-tab block:
// [Departments] shows department cards (icon, title, description, live doctor
// count) and [Symptoms] shows light-blue symptom cards that deep-link into the
// doctor search filtered by the linked department. Both are fully managed from
// the Admin Panel (app/admin/departments, app/admin/symptoms).
model Department {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  title    String // e.g. "General Physician"
  subtitle String? // short description line under the title
  slug     String   @unique // e.g. "general-physician" — used for counts & nav
  icon     String   @default("Stethoscope") // lucide icon name
  order    Int      @default(0)
  isActive Boolean  @default(true)
  symptoms Symptom[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Symptom {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  title              String // e.g. "Period problems"
  slug               String     @unique // navigation slug if no department linked
  image              String? // optional image URL for the card
  linkedDepartmentId String?    @db.ObjectId
  department         Department? @relation(fields: [linkedDepartmentId], references: [id])
  order              Int        @default(0)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

// ================= E-COMMERCE / HEALTH CATALOGUE CMS =================
// The three catalogue collections below power the public Medicine Shop, the
// Lab Test Packages grid and the Health Membership plans — all managed live
// from the Admin panel (app/admin/{medicines,lab-tests,health-plans}).

// Medicine catalogue managed by the Admin (CityDoctor Express Pharmacy).
model Medicine {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  category        String   @default("General") // e.g. Fever & Pain, Vitamins & Supplements
  brand           String   @default("") // Manufacturer e.g. Square Pharma
  composition     String   @default("") // Active ingredients e.g. Paracetamol 500mg
  form            String   @default("Medicine") // Tablet / Capsule / Syrup
  imageUrl        String   @default("") // Public /upload/* URL or CDN link
  regularPrice    Float    @default(0)
  discountedPrice Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Diagnostic checkup packages sold with home sample collection.
model LabTestPackage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  category        String   @default("Health Checkup") // e.g. Full Body Screening
  testsCount      Int      @default(1)
  regularPrice    Float    @default(0)
  discountedPrice Float    @default(0)
  features        String[] // List of inclusion bullets rendered on the public grid
  popular         Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Recurring health membership / subscription plans (CityDoctor Plus).
model HealthPlan {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  tagline       String   @default("")
  familyMembers Int      @default(1) // Number of covered family members
  monthlyPrice  Float    @default(0)
  yearlyPrice   Float    @default(0)
  features      String[] // Feature bullets shown on the membership card
  popular       Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
